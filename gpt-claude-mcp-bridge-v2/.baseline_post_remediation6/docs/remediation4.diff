-        return out
-    if isinstance(value, str):
-        out.append(value)
-    elif isinstance(value, Mapping):
-        for key, inner in value.items():
-            if str(key).lower() in _INPUT_KEYS:
-                continue
-            out.extend(_gather_text(inner, depth + 1))
-    elif isinstance(value, (list, tuple)):
-        for inner in value:
-            out.extend(_gather_text(inner, depth + 1))
-    return out
