-            proc.stdout.close()
-        raise
-    t.join(timeout=10)
-    complete = (not t.is_alive()) and not state["truncated"] and not state["error"]
-    if not t.is_alive() and proc.stdout is not None:
-        proc.stdout.close()
-    return proc.returncode or 0, bytes(kept), complete
