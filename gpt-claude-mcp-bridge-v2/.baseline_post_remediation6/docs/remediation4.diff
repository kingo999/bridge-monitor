-    def pick(base: str, default: str, pattern: re.Pattern[str], what: str) -> tuple[str, str]:
-        for name in (f"{base}_{suffix}", base):
-            raw = _get(env, name)
-            if raw is not None:
-                if not pattern.fullmatch(raw):
