+        helper.write_text('#!/bin/sh\nkind="$1"\n'
+                          f'echo "$kind" >> "{self.w.tmp.as_posix()}/fired_$kind.txt"\n'
+                          'case "$kind" in\n  clean) cat ;;\n  textconv) cat "$2" ;;\n  *) exit 0 ;;\nesac\n',
+                          encoding="utf-8", newline="\n")
