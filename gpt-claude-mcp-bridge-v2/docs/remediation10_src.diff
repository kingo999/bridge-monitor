+def stage_a_allows_live(rows: list[tuple[str, str, str]]) -> bool:
+    """May stage B (which spends allowance) run?  Not when anything FAILED (a write got through, or a
+    control broke) and not unless the preflight and BOTH controls passed: the sandbox must be launchable
+    and the patch engine able to write when writes are allowed.  The A3 attacks being INCONCLUSIVE alone
+    does not block it: with Codex 0.162.1 the patch engine reports only `Failed to write file <path>` and
+    never an OS denial code (observed), so a strict stage A can never be a clean pass, and stage B is what
+    adds the model-driven evidence."""
+    if any(status == "FAIL" for _, status, _ in rows):
+        return False
+    required = [status for name, status, _ in rows
+                if name == "sandbox preflight" or name.startswith(("A1 control", "A2 control"))]
+    return len(required) == 3 and all(status == "PASS" for status in required)
