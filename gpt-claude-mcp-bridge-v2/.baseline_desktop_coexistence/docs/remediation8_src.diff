+def sandbox_log_evidence(env: Mapping[str, str], since_epoch: float) -> dict[str, str | None] | None:
+    """The last setup-refresh failure the Codex sandbox log recorded SINCE ``since_epoch`` (this call's
+    own window), or None.  Only the two refresh-failure line shapes are read; nothing else from the log
+    is parsed, kept or printed, and every value is sanitised.  A target is reported only when the log
+    names a file; the OS reason is classified from its own text.  Never raises."""
+    try:
+        base = Path(env.get("CODEX_HOME") or (Path.home() / ".codex")) / ".sandbox"
+        logs = sorted(base.glob("sandbox.*.log"), key=lambda p: p.stat().st_mtime, reverse=True)[:2]
+    except OSError:
+        return None
+    found: dict[str, str | None] | None = None
+    for log in reversed(logs):                       # oldest first, so the newest entry wins
+        try:
+            if log.stat().st_mtime < since_epoch - 5:
+                continue
+            with open(log, "rb") as handle:
+                handle.seek(0, os.SEEK_END)
+                handle.seek(max(0, handle.tell() - _LOG_TAIL_BYTES))
+                raw = handle.read()
+        except OSError:
+            continue
+        for line in raw.decode("utf-8", errors="replace").splitlines():
+            m = _ISO_LINE.match(line)
+            if m is None:
+                continue
+            try:
+                when = datetime.fromisoformat(m.group("ts")).timestamp()
+            except ValueError:
+                continue
+            if when < since_epoch - _LOG_SLACK_S:
+                continue
+            body = m.group("body")
+            if "runtime read/execute validation failed" in body:
+                t = _REFRESH_TARGET.search(body)
+                rest = t.group("rest") if t else body
+                low = rest.lower()
+                reason = ("in_use" if ("os error 32" in low or "being used by another process" in low) else
+                          "access_denied" if ("os error 5" in low or "access is denied" in low) else "other")
+                found = {"target": _clean(t.group("path"), env, 260) if t else None, "reason": reason,
+                         "snippet": _clean(rest, env, 200), "log": log.name}
+            elif "setup refresh completed with errors" in body and found is None:
+                found = {"target": None, "reason": "other", "snippet": _clean(body, env, 200), "log": log.name}
+    return found
+
+
