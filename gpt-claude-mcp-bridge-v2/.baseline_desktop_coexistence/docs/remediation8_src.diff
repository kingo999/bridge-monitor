+def _shorten_home(text: str, env: Mapping[str, str]) -> str:
+    for key in ("USERPROFILE", "HOME"):
+        home = env.get(key)
+        if home and len(home) > 3:
+            text = text.replace(home, "~").replace(home.replace("\\", "/"), "~")
+    return text
+
+
+def _clean(text: str, env: Mapping[str, str], limit: int) -> str:
+    text = _shorten_home(redact(text), env)
+    return "".join(ch if ch.isprintable() else " " for ch in text)[:limit]
+
