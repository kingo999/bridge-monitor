+def _smallest_ascii_tracked_file(repo_root: Path, env: Mapping[str, str]) -> str | None:
+    """A small tracked file to probe source readability (chosen host-side, never logged)."""
+    try:
+        res = subprocess.run(
+            ["git", "--no-optional-locks", "-C", str(repo_root), "ls-files", "-z"],
+            stdin=subprocess.DEVNULL, capture_output=True, timeout=20, check=False, env=dict(env),
+        )
+    except Exception:  # noqa: BLE001
+        return None
+    best: tuple[int, str] | None = None
+    for raw in res.stdout.split(b"\0"):
+        if not raw:
+            continue
+        try:
+            name = raw.decode("ascii")
+        except UnicodeDecodeError:
+            continue
+        path = repo_root / name
+        try:
+            size = path.stat().st_size
+        except OSError:
+            continue
+        if 0 < size <= _MAX_SOURCE_PROBE_BYTES and (best is None or size < best[0]):
+            best = (size, name)
+    return best[1] if best else None
