+
+def cmd_fingerprint() -> None:
+    fp = fingerprint()
+    out = write("source_fingerprint.json", {**fp, "environment": environment(),
+                                            "evidence_class": "source_observation"})
+    print(f"{out}  combined={fp['combined_sha256']}  files={fp['file_count']}")
