+def run_problems(*, before: str, after: str, exit_code: int, skipped: int, failing: list[str],
+                 tests_run: int | None) -> list[str]:
+    """Why a test run cannot be recorded as passing evidence ([] = valid).  Pure, so it is tested."""
+    problems: list[str] = []
