++    out: list[str] = []
++    i = 0
++    while i < len(inner):
++        c = inner[i]
++        if c != "\\":
++            out.append(c)
++            i += 1
++            continue
++        i += 1
++        if i >= len(inner):
++            return None
++        e = inner[i]
++        if e in _ESCAPES:
++            out.append(_ESCAPES[e])
++            i += 1
++        elif e in "ux":
