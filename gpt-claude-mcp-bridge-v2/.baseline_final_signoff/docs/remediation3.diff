+    """Normalised directories that executables must not be taken from."""
+    roots: list[str] = []
+    for item in (os.getcwd(), env.get("CLAUDE_PROJECT_DIR") or os.environ.get("CLAUDE_PROJECT_DIR"), *extra):
+        if item:
+            try:
+                roots.append(_norm(item))
+            except OSError:
+                continue
+    return roots
+
+
