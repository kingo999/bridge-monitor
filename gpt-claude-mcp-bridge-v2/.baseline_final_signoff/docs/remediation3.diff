++            if depth < 0:
++                return None
++        if ch == ";" or (ch == "\n" and depth == 0):
++            stmt = "".join(cur).strip()
++            if stmt:
++                out.append(stmt)
++            cur = []
++        else:
++            cur.append(ch)
++        i += 1
++    if depth != 0:
