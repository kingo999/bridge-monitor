+    names: Sequence[str],
+    env: Mapping[str, str],
+    *,
+    exclude: Iterable[str | os.PathLike[str]] = (),
+) -> str | None:
+    """Absolute path of the first match among ``names`` found in a trusted PATH directory."""
+    roots = excluded_roots(env, exclude)
+    seen: set[str] = set()
+    for entry in _path_value(env).split(os.pathsep):
